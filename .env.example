# Copie para .env e preencha o que for usar.
# Sem credenciais, a plataforma correspondente entra em dry-run (nada é enviado).

# --- servidor ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
ORCAPRO_DATA_FILE=data/campaigns.json
ORCAPRO_HTTP_TIMEOUT_MS=15000

# true = simula tudo, mesmo com credenciais válidas. Use para testar sem gastar.
ORCAPRO_DRY_RUN=true

# --- Meta Ads (Facebook / Instagram) ---
# Token de sistema com a permissão ads_management.
META_ACCESS_TOKEN=
# Com ou sem o prefixo act_.
META_AD_ACCOUNT_ID=
META_API_VERSION=v21.0

# --- Google Ads ---
# Access token OAuth2 já renovado (o refresh fica fora do escopo deste serviço).
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Preencha quando operar a conta a partir de um MCC.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v18

# --- TikTok Ads ---
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=
TIKTOK_API_VERSION=v1.3

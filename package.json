{
  "name": "orcapro",
  "version": "0.1.0",
  "private": true,
  "description": "Gestão e publicação de campanhas de anúncios (Meta Ads, Google Ads, TikTok Ads)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",

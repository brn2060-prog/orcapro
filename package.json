    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts",
    "campanha": "tsx src/cli.ts"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
